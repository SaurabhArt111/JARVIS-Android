    <path
        android:fillColor="#4D22D3EE"
        android:pathData="M54,43.5L63.2,59.5L44.8,59.5Z"
        android:strokeColor="#E6FBFF"
        android:strokeWidth="2.2"
        android:strokeLineJoin="round" />
    <!-- centre spark -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M54,55.2m-2.2,0a2.2,2.2 0 1,1 4.4,0a2.2,2.2 0 1,1 -4.4,0" />
