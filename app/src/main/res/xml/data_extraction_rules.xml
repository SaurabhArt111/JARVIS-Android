<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: nothing JARVIS stores (chat history, reminders, notes, encrypted API keys, settings) is copied to the cloud or to a new phone.
     allowBackup="false" already covers older versions; these rules cover the cloud-backup and device-to-device transfer paths of Android 12+. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
